// Zero-Copy Shared Memory Native Processor for {{PLUGIN_NAME}}
//
// Architecture Overview:
// This class acts as the real-time C++ audio bridge between Steinberg's VST3
// SDK callbacks and the compiled Dart AOT executable (`{{PLUGIN_ID}}_processor`).
//
// Key Responsibilities:
// 1. Shared Memory Management:
//    Allocates a page-aligned POSIX shared memory block (`/vst3_shm_<pid>_<id>`)
//    and maps it into process address space.
// 2. Inter-Process Synchronization:
//    Opens POSIX named semaphores (`/vst3_r_...` for ready, `/vst3_d_...` for done).
// 3. Process Lifecycle:
//    Locates the bundled Dart executable in the `.vst3` bundle and spawns it
//    via `fork()` + `execl()`. Performs a 3-second initialization handshake.
// 4. Real-time Audio Exchange:
//    Copies audio blocks into shared memory, signals the Dart worker, and waits
//    for completion with a 50ms safety timeout. If Dart times out, silence is
//    output to prevent DAW buffer freezing.
// 5. Thread-safe Parameter Modulation:
//    Pushes DAW parameter automation into a lock-free circular ring buffer.

#include "vst3_shared_memory.h"
#include <iostream>
#include <stdexcept>
#include <vector>
#include <cstring>
#include <thread>
#include <mutex>
#include <chrono>
#include <libgen.h>
#include <dlfcn.h>
#include <cstdlib>
#include <algorithm>

#ifdef _WIN32
    #include <windows.h>
#else
    #include <sys/mman.h>
    #include <semaphore.h>
    #include <fcntl.h>
    #include <unistd.h>
    #include <sys/wait.h>
#endif

// Forward declaration to retrieve bundle executable path via dladdr
static void dummy_function() {}

/// Native C++ audio processor managing the Dart child process and shared memory IPC.
class {{PLUGIN_CLASS_NAME}}NativeProcessor {
private:
    std::string shm_name;
    std::string sem_ready_name;
    std::string sem_done_name;
    int shm_fd = -1;
    Vst3SharedMemory* shm = nullptr;
    sem_t* sem_ready = nullptr;
    sem_t* sem_done = nullptr;
    bool initialized = false;
    std::mutex io_mutex;
    std::string dart_exe_path;
    pid_t child_pid = -1;

    /// Discovers the absolute directory of the VST3 bundle binary and locates the Dart executable.
    std::string getExecutablePath() {
        Dl_info dl_info;
        if (dladdr((void*)&dummy_function, &dl_info) != 0) {
            char* path_copy = strdup(dl_info.dli_fname);
            char* dir = dirname(path_copy);
            std::string dart_path = std::string(dir) + "/{{PLUGIN_ID}}_processor";
            free(path_copy);
            return dart_path;
        }
        throw std::runtime_error("FAILED TO GET VST3 BINARY PATH!");
    }

public:
    /// Initializes shared memory, semaphores, spawns Dart process, and awaits handshake ACK.
    void initialize(double sampleRate, int maxBlockSize) {
        if (initialized) return;

        dart_exe_path = getExecutablePath();

        // Generate unique names under macOS's 31-char limit for POSIX semaphores
        uintptr_t id = reinterpret_cast<uintptr_t>(this) & 0xFFFF;
        shm_name = "/vst3_shm_" + std::to_string(getpid()) + "_" + std::to_string(id);
        sem_ready_name = "/vst3_r_" + std::to_string(getpid()) + "_" + std::to_string(id);
        sem_done_name = "/vst3_d_" + std::to_string(getpid()) + "_" + std::to_string(id);

        shm_unlink(shm_name.c_str());
        sem_unlink(sem_ready_name.c_str());
        sem_unlink(sem_done_name.c_str());

        // Create and map shared memory
        shm_fd = shm_open(shm_name.c_str(), O_CREAT | O_RDWR, 0666);
        if (shm_fd < 0) {
            throw std::runtime_error("FAILED TO CREATE SHARED MEMORY: " + shm_name);
        }
        if (ftruncate(shm_fd, VST3_SHM_TOTAL_SIZE) != 0) {
            throw std::runtime_error("FAILED TO TRUNCATE SHARED MEMORY");
        }
        shm = reinterpret_cast<Vst3SharedMemory*>(
            mmap(NULL, VST3_SHM_TOTAL_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0)
        );
        if (shm == MAP_FAILED) {
            throw std::runtime_error("FAILED TO MMAP SHARED MEMORY");
        }

        memset(shm, 0, VST3_SHM_TOTAL_SIZE);
        shm->magic = VST3_SHM_MAGIC;
        shm->version = VST3_SHM_VERSION;
        shm->sampleRate = sampleRate;
        shm->maxBlockSize = maxBlockSize;
        shm->command = VST3_CMD_IDLE;
        vst3_set_active_shm(shm_name.c_str(), shm);

        sem_ready = sem_open(sem_ready_name.c_str(), O_CREAT, 0666, 0);
        sem_done = sem_open(sem_done_name.c_str(), O_CREAT, 0666, 0);
        if (sem_ready == SEM_FAILED || sem_done == SEM_FAILED) {
            throw std::runtime_error("FAILED TO CREATE POSIX SEMAPHORES");
        }

        // Spawn Dart processor
        child_pid = fork();
        if (child_pid == -1) {
            throw std::runtime_error("FAILED TO FORK DART PROCESS!");
        }

        if (child_pid == 0) {
            execl(dart_exe_path.c_str(), "{{PLUGIN_ID}}_processor",
                  shm_name.c_str(), sem_ready_name.c_str(), sem_done_name.c_str(), nullptr);
            exit(1);
        }

        // Wait up to 3 seconds for Dart process initialization ACK
        bool acked = false;
        for (int i = 0; i < 300; ++i) {
            if (sem_trywait(sem_done) == 0) {
                acked = true;
                break;
            }
            std::this_thread::sleep_for(std::chrono::milliseconds(10));
        }

        if (!acked) {
            throw std::runtime_error("DART PROCESS TIMED OUT DURING INITIALIZATION!");
        }

        initialized = true;
    }

    /// Renders a stereo audio block by triggering Dart processing over shared memory.
    void processStereo(float* inputL, float* inputR,
                      float* outputL, float* outputR, int numSamples) {
        if (!initialized || !shm) {
            throw std::runtime_error("NOT INITIALIZED!");
        }

        std::lock_guard<std::mutex> lock(io_mutex);
        int samplesToProcess = std::min(numSamples, static_cast<int>(VST3_SHM_MAX_SAMPLES));

        memcpy(shm->inputL, inputL, samplesToProcess * sizeof(float));
        memcpy(shm->inputR, inputR, samplesToProcess * sizeof(float));
        shm->numSamples = samplesToProcess;
        shm->command = VST3_CMD_PROCESS;

        sem_post(sem_ready);


        // Wait up to 50ms for Dart DSP processing to complete
        bool done = false;
        for (int i = 0; i < 500; ++i) {
            if (sem_trywait(sem_done) == 0) {
                done = true;
                break;
            }
            std::this_thread::sleep_for(std::chrono::microseconds(100));
        }

        if (done) {
            memcpy(outputL, shm->outputL, samplesToProcess * sizeof(float));
            memcpy(outputR, shm->outputR, samplesToProcess * sizeof(float));
        } else {
            // Safety: silence output if Dart timed out
            memset(outputL, 0, samplesToProcess * sizeof(float));
            memset(outputR, 0, samplesToProcess * sizeof(float));
        }
    }

    /// Enqueues a parameter automation event into the shared memory ring buffer.
    void setParameter(int paramId, double value) {
        if (!initialized || !shm) return;
        std::lock_guard<std::mutex> lock(io_mutex);

        uint32_t w = shm->hostParamWriteIndex;
        uint32_t r = shm->hostParamReadIndex;
        if (w - r < VST3_SHM_PARAM_QUEUE_SIZE) {
            uint32_t slot = w % VST3_SHM_PARAM_QUEUE_SIZE;
            shm->hostParams[slot].paramId = paramId;
            shm->hostParams[slot].value = value;
            shm->hostParamWriteIndex = w + 1;
        }
    }

    void reset() {}

    /// Shuts down the Dart process, unlinks shared memory and semaphores, and frees resources.
    void dispose() {
        if (!initialized) return;

        if (shm) {
            vst3_set_active_shm(nullptr, nullptr);
            shm->command = VST3_CMD_TERMINATE;
            sem_post(sem_ready);
            munmap(shm, VST3_SHM_TOTAL_SIZE);
            shm = nullptr;
        }

        if (shm_fd >= 0) {
            close(shm_fd);
            shm_unlink(shm_name.c_str());
            shm_fd = -1;
        }

        if (sem_ready) {
            sem_close(sem_ready);
            sem_unlink(sem_ready_name.c_str());
            sem_ready = nullptr;
        }

        if (sem_done) {
            sem_close(sem_done);
            sem_unlink(sem_done_name.c_str());
            sem_done = nullptr;
        }

        if (child_pid > 0) {
            int status;
            waitpid(child_pid, &status, WNOHANG);
            child_pid = -1;
        }

        initialized = false;
    }

    ~{{PLUGIN_CLASS_NAME}}NativeProcessor() {
        dispose();
    }
};

static {{PLUGIN_CLASS_NAME}}NativeProcessor* g_processor = nullptr;

// C-linkage export functions called by the VST3 C++ component wrapper (IAudioProcessor)
extern "C" {
    /// Initializes the native DSP engine with host sample rate and block size.
    void {{PLUGIN_ID}}_native_initialize(double sample_rate, int max_block_size) {
        try {
            if (!g_processor) g_processor = new {{PLUGIN_CLASS_NAME}}NativeProcessor();
            g_processor->initialize(sample_rate, max_block_size);
        } catch (const std::exception& e) {
            fprintf(stderr, "{{PLUGIN_NAME_UPPER}} NATIVE FAILURE: %s\n", e.what());
            abort();
        }
    }

    /// Renders incoming stereo audio blocks through the shared memory Dart pipeline.
    void {{PLUGIN_ID}}_native_process_stereo(float* inputL, float* inputR,
                                   float* outputL, float* outputR, int samples) {
        try {
            if (!g_processor) throw std::runtime_error("NOT INITIALIZED!");
            g_processor->processStereo(inputL, inputR, outputL, outputR, samples);
        } catch (const std::exception& e) {
            fprintf(stderr, "{{PLUGIN_NAME_UPPER}} NATIVE FAILURE: %s\n", e.what());
            abort();
        }
    }

    /// Updates a plugin parameter from DAW automation.
    void {{PLUGIN_ID}}_native_set_parameter(int param_id, double value) {
        if (g_processor) g_processor->setParameter(param_id, value);
    }

    double {{PLUGIN_ID}}_native_get_parameter(int param_id) {
        return 0.0;
    }

    void {{PLUGIN_ID}}_native_reset() {
        if (g_processor) g_processor->reset();
    }

    /// Disposes the native processor singleton and child process.
    void {{PLUGIN_ID}}_native_dispose() {
        if (g_processor) {
            g_processor->dispose();
            delete g_processor;
            g_processor = nullptr;
        }
    }
}